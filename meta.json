{
  "module_id": "erh:isaac-sim",
  "visibility": "public",
  "url": "https://github.com/erh/viam-isaac-sim",
  "description": "Control and simulate robots in NVIDIA Isaac Sim through Viam",
  "models": [
    {
      "model": "erh:isaac-sim:world",
      "api": "rdk:component:generic",
      "short_description": "Boots and manages the Isaac Sim world/stage"
    },
    {
      "model": "erh:isaac-sim:scene-finalizer",
      "api": "rdk:component:generic",
      "short_description": "Defers first scene render until configured component population completes"
    },
    {
      "model": "erh:isaac-sim:arm",
      "api": "rdk:component:arm",
      "short_description": "A simulated arm (UR, Franka, or any articulation USD)"
    },
    {
      "model": "erh:isaac-sim:camera",
      "api": "rdk:component:camera",
      "short_description": "A simulated RGB camera in the Isaac Sim stage"
    },
    {
      "model": "erh:isaac-sim:base",
      "api": "rdk:component:base",
      "short_description": "A simulated differential-drive base"
    }
  ],
  "entrypoint": "dist/run.sh",
  "first_run": "first_run.sh",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64"
    ]
  }
}
